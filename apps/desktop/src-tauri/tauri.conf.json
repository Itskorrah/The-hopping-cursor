{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Hopping Cursor",
  "version": "0.1.0",
  "identifier": "com.itskorrah.hoppingcursor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"The Hopping Cursor","width":1180,"height":800,"minWidth":820,"minHeight":600,"dragDropEnabled":true}],
    "security": {"csp":"default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'"}
  },
  "bundle": {
    "active":true,
    "targets":"all",
    "icon":["icons/32x32.png","icons/128x128.png","icons/icon.ico","icons/icon.icns"],
    "category":"Utility",
    "shortDescription":"Share input and files across your local computers.",
    "macOS":{"minimumSystemVersion":"12.0","infoPlist":"Info.plist","signingIdentity":"-"},
    "windows":{"nsis":{"displayLanguageSelector":false}}
  }
}
